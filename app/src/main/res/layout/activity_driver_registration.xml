<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Driver Registration Portal"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- STEP 1: Glass Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Step 1: Personal Information"
                android:textColor="@color/app_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDriverLastName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="Last Name"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etDriverFirstName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="First Name"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etDriverMiddleName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="Middle Name (Optional)"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etDriverLicense"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="Driver's License Number"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <!-- YELLOW OVAL BUTTON -->
            <android.widget.Button
                android:id="@+id/btnUploadDriver2x2"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_btn_yellow"
                android:text="Upload 2x2 Picture of Driver"
                android:textColor="#000000"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDriver2x2Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No 2x2 picture attached"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- STEP 2: Glass Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_glass_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvUnitTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Step 2: Tricycle Details (Unit 1)"
                android:textColor="@color/app_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/etTricycleType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:completionThreshold="1"
                android:hint="Type of Tricycle (e.g., Honda)"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etPlateNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="Plate Number (e.g., AB-1234)"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <!-- YELLOW OVAL BUTTON -->
            <android.widget.Button
                android:id="@+id/btnUploadTricyclePic"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_btn_yellow"
                android:text="Upload Picture of Tricycle"
                android:textColor="#000000"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTricyclePicStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="No tricycle picture attached"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <!-- YELLOW OVAL BUTTON -->
            <android.widget.Button
                android:id="@+id/btnAddAnotherUnit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_btn_yellow"
                android:text="+ Add Another Tricycle Unit"
                android:textColor="#000000"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- YELLOW OVAL BUTTON (Submit) -->
        <android.widget.Button
            android:id="@+id/btnSubmitDriverReg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_btn_yellow"
            android:elevation="4dp"
            android:text="Complete Registration &amp; Submit"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
