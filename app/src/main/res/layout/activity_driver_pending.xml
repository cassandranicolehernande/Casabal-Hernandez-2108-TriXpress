<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Glassmorphism Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Status Icon -->
        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="⏳"
            android:textSize="48sp" />

        <!-- Changed to app_blue for readability -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Application Under Review"
            android:textColor="@color/app_blue"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Changed to text_dark for readability -->
        <TextView
            android:id="@+id/tvApprovalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="An admin will examine your information, license, and compliance with TriXpress rules and terms &amp; conditions. Please wait for approval."
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <!-- Check Status Button -->
        <android.widget.Button
            android:id="@+id/btnCheckStatus"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_yellow"
            android:text="Refresh / Check Status"
            android:textColor="@color/app_blue"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>