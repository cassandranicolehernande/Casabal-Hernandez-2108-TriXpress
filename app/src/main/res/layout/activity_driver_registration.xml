<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Driver Registration Portal"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- STEP 1: Personal & TODA Info Glass Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Step 1: Personal &amp; TODA Information"
                android:textColor="@color/app_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDriverLastName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="Last Name"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etDriverFirstName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="First Name"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etDriverMiddleName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="Middle Name (Optional)"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etDriverContact"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="Driver Contact Number (+63 9XX XXX XXXX)"
                android:inputType="phone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <AutoCompleteTextView
                android:id="@+id/etTodaAssociation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:completionThreshold="1"
                android:hint="TODA Association (e.g., ARASOF TODA)"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etRegisteredZone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="Registered TODA Service Zone (e.g., Nasugbu Zone 1)"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etDriverLicense"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="Driver's License Number"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <!-- Photo Upload with Preview -->
            <ImageView
                android:id="@+id/iv2x2Preview"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:src="@drawable/trikeicon"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <android.widget.Button
                android:id="@+id/btnUploadDriver2x2"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_btn_yellow"
                android:text="📷 Upload 2x2 Picture of Driver"
                android:textColor="#000000"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDriver2x2Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No 2x2 picture attached"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- STEP 2: Tricycle Details Glass Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_glass_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvUnitTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Step 2: Tricycle Unit Details"
                android:textColor="@color/app_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/etTricycleType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:completionThreshold="1"
                android:hint="Type / Model of Tricycle (e.g., Bajaj, Honda TMX)"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etSeaterCapacity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="Seating Capacity (Auto-Detected)"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <EditText
                android:id="@+id/etPlateNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext_glass"
                android:hint="Plate Number (e.g., AB-1234)"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#000000"
                android:textColorHint="@color/text_hint" />

            <!-- Tricycle Photo Upload with Preview -->
            <ImageView
                android:id="@+id/ivTrikePhotoPreview"
                android:layout_width="140dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:src="@drawable/trikeicon"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <android.widget.Button
                android:id="@+id/btnUploadTricyclePic"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_btn_yellow"
                android:text="🛺 Upload Picture of Tricycle"
                android:textColor="#000000"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTricyclePicStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No tricycle picture attached"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Submit Button -->
        <android.widget.Button
            android:id="@+id/btnSubmitDriverReg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_btn_yellow"
            android:elevation="4dp"
            android:text="Complete Registration &amp; Submit"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
