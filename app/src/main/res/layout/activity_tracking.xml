<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A237E">

    <!-- Map View Fragment -->
    <fragment
        android:id="@+id/trackingMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Status Overlay Card (Glassmorphism Blue & Yellow) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#CC1A237E"
        app:strokeWidth="1.5dp"
        app:strokeColor="#80FFC107"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTripStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛺 Driver Arriving at Pick-up"
                android:textColor="#FFC107"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvTrackingDriver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver: Kuya Roberto (ARASOF TODA)\nPlate: AB-1234 • 4.9★"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabTrackingMapLayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="110dp"
        android:src="@android:drawable/ic_menu_mapmode"
        app:backgroundTint="#FFC107"
        app:tint="#1A237E"
        app:fabSize="mini"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Map Layer" />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#E61A237E"
        app:strokeWidth="1.5dp"
        app:strokeColor="#80FFC107"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTrackingInstruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Driver is on the way to pick-up point"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFC107" />

                    <TextView
                        android:id="@+id/tvEstimatedTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimated Time of Arrival: 2 mins"
                        android:textSize="14sp"
                        android:textColor="#E0E0E0"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- SOS Button (Pill/Oval) -->
                <Button
                    android:id="@+id/btnSos"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text=" 🚨"
                    android:textSize="18sp"
                    android:background="@drawable/bg_btn_yellow"
                    android:backgroundTint="#D32F2F" />
            </LinearLayout>

            <!-- Button to open official native Google Maps app directly -->
            <android.widget.Button
                android:id="@+id/btnOpenGoogleMapsApp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_btn_yellow"
                android:text="🗺️Use Google Maps App"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp" />


            <android.widget.Button
                android:id="@+id/btnActionTrip"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_yellow"
                android:text="Confirm Driver Arrived &amp; Start Trip"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="16sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
