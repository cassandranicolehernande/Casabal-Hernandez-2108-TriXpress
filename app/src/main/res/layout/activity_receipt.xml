<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Screen Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧾 TriXpress Trip Receipt"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFC107"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <!-- Receipt Main Glass Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="24dp"
            android:elevation="8dp"
            android:layout_marginBottom="24dp">

            <!-- Driver Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tricycle Driver"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptDriver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginBottom="16dp" />

            <!-- Route Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick-up Location"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptPickup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup Location"
                android:textSize="15sp"
                android:textColor="#000000"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Destination"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptDestination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Destination Location"
                android:textSize="15sp"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:background="#80FFE082"
                android:layout_marginBottom="16dp" />

            <!-- Total Fare Paid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Fare Paid"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />

                <TextView
                    android:id="@+id/tvReceiptFare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱0.00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F" />
            </LinearLayout>

        </LinearLayout>

        <android.widget.Button
            android:id="@+id/btnRateDriver"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_yellow"
            android:text="⭐ Rate Driver"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <android.widget.Button
            android:id="@+id/btnBackToDashboard"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_yellow"
            android:backgroundTint="#CC1A237E"
            android:text="🔙 Back to Dashboard"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
