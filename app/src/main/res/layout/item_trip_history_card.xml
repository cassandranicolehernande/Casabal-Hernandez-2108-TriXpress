<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card"
    android:padding="20dp"
    android:elevation="6dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvHistoryDriver"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Past Ride • ARASOF Campus TODA"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvHistoryFare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱50.00"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistoryRoute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BatStateU ARASOF Campus to Public Market"
        android:textSize="13sp"
        android:textColor="#333333"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvHistoryRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★★★★★ (5.0)"
        android:textColor="#FFC107"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
