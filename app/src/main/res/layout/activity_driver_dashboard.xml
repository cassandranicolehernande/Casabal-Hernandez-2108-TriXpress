<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛺 Driver Dispatch Dashboard"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFC107"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <!-- Incoming Ride Request Card (Glassmorphism) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="20dp"
            android:elevation="8dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 Incoming Ride Request"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup Location"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDriverPickup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BatStateU ARASOF Campus"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Destination"
                android:textSize="12sp"
                android:textColor="#555555"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDriverDestination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nasugbu Public Market"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvDriverFare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Est. Fare: ₱50.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginBottom="20dp" />

            <!-- Action Buttons (Pill / Oval-Rectangle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <android.widget.Button
                    android:id="@+id/btnAcceptRide"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_yellow"
                    android:text="Accept Ride"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginEnd="8dp" />

                <android.widget.Button
                    android:id="@+id/btnDeclineRide"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_yellow"
                    android:backgroundTint="#D32F2F"
                    android:text="Decline"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Earnings Summary Card (Glassmorphism) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="20dp"
            android:elevation="6dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Driver Earnings"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Completed Rides Today"
                    android:textColor="#555555" />

                <TextView
                    android:id="@+id/tvCompletedRides"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 rides"
                    android:textStyle="bold"
                    android:textColor="#111111" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Earnings"
                    android:textColor="#555555" />

                <TextView
                    android:id="@+id/tvTotalEarnings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱450.00"
                    android:textStyle="bold"
                    android:textColor="#2E7D32" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
