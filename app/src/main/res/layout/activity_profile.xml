<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_main_gradient">

    <!-- Scrollable Profile Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👤 Profile &amp; Settings"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFC107"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp" />

            <!-- User Profile Card (Glassmorphism) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:elevation="8dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Details"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:layout_marginBottom="12dp" />

                <!-- User Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Passenger User"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:layout_marginBottom="12dp" />

                <!-- Phone / Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Number / Email"
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileContact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+63 912 345 6789"
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="12dp" />

                <!-- Zone / Address -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registered Zone"
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileZone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nasugbu, Batangas (Zone 1)"
                    android:textSize="15sp"
                    android:textColor="#000000" />

            </LinearLayout>

            <!-- Preferences & App Options (Glassmorphism) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:elevation="8dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App Settings"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:layout_marginBottom="12dp" />

                <android.widget.Button
                    android:id="@+id/btnEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_btn_yellow"
                    android:text="Edit Account Details"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <android.widget.Button
                    android:id="@+id/btnTripHistory"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_btn_yellow"
                    android:text="View Recent Bookings"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- Logout Button (Pill Shape) -->
            <android.widget.Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_yellow"
                android:backgroundTint="#D32F2F"
                android:text="Logout"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Exploration / Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#1A237E"
        android:elevation="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnNavDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Dashboard"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnNavExplore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Explore Zones"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnNavHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="History"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

</LinearLayout>
