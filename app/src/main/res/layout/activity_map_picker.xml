<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/pickerMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Instructions Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvMapInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1 of 2: Pin your PICK-UP location"
                android:textColor="#1A237E"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectedLocationSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Move the map to position the marker at your exact pickup spot."
                android:textColor="#555555"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Action Card -->
    <LinearLayout
        android:id="@+id/layoutBottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/layoutServiceAndMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Service Type:"
                android:textColor="#1A237E"
                android:textStyle="bold"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgMapServiceType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/rbMapStandard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Standard"
                    android:textColor="#1A237E" />
                <RadioButton
                    android:id="@+id/rbMapDelivery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery"
                    android:textColor="#1A237E" />
                <RadioButton
                    android:id="@+id/rbMapPakyaw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pakyaw"
                    android:textColor="#1A237E" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ride Mode:"
                android:textColor="#1A237E"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <RadioGroup
                android:id="@+id/rgMapRideMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/rbMapPasabay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Pasabay lang"
                    android:textColor="#1A237E" />
                <RadioButton
                    android:id="@+id/rbMapKasya"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kasya kami riyan!"
                    android:textColor="#1A237E" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/btnMapConfirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#FFC107"
            android:text="Confirm Pick-up Location"
            android:textColor="#1A237E"
            android:textStyle="bold"
            android:textSize="16sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Map Layer FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMapType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_menu_mapmode"
        app:backgroundTint="#FFFFFF"
        app:tint="#1A237E"
        app:fabSize="mini"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomCard"
        android:contentDescription="Map Layer" />

</androidx.constraintlayout.widget.ConstraintLayout>