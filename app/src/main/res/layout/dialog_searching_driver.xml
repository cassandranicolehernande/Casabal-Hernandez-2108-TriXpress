<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center"
    android:background="@drawable/bg_glass_card">

    <ProgressBar
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminateTint="#1A237E"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvSearchStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Locating nearby TODA drivers..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSearchSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connecting you to the nearest licensed tricycle unit in Nasugbu..."
        android:textSize="13sp"
        android:textColor="#555555"
        android:gravity="center" />

</LinearLayout>
