<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:padding="24dp">

    <!-- Screen Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trip Receipt"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Receipt Main Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="20dp"
        android:elevation="3dp"
        android:layout_marginBottom="24dp">

        <!-- Driver Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tricycle Driver"
            android:textSize="12sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/tvReceiptDriver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginBottom="16dp" />

        <!-- Route Details -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pick-up Location"
            android:textSize="12sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/tvReceiptPickup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pickup Location"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destination"
            android:textSize="12sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/tvReceiptDestination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destination Location"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- Total Fare Paid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Fare Paid"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <TextView
                android:id="@+id/tvReceiptFare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />
        </LinearLayout>

    </LinearLayout>

    <!-- Navigation Buttons -->
    <Button
        android:id="@+id/btnRateDriver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rate Driver"
        android:backgroundTint="#111111"
        android:textColor="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnBackToDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Dashboard"
        android:backgroundTint="#666666"
        android:textColor="@android:color/white"
        android:padding="12dp" />

</LinearLayout>
