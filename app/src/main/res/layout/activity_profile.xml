<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile &amp; Settings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- User Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="20dp"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Details"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#888888"
                android:layout_marginBottom="12dp" />

            <!-- User Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textSize="12sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passenger User"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginBottom="12dp" />

            <!-- Phone / Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Number / Email"
                android:textSize="12sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvProfileContact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+63 912 345 6789"
                android:textSize="15sp"
                android:textColor="#222222"
                android:layout_marginBottom="12dp" />

            <!-- Zone / Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registered Zone"
                android:textSize="12sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvProfileZone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nasugbu, Batangas (Zone 1)"
                android:textSize="15sp"
                android:textColor="#222222" />

        </LinearLayout>

        <!-- Preferences & App Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="20dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Settings"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#888888"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Account Details"
                android:backgroundTint="#444444"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnTripHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Recent Bookings"
                android:backgroundTint="#444444"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:backgroundTint="#D32F2F"
            android:textColor="@android:color/white"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
